<main class="wrap">

  <header class="head">
    <img class="logo" src="/assets/img/logo-uo.png" width="500" height="90"
         alt="Uniwersytet Opolski">
  </header>

  <p class="pill" id="pill">
    <span class="dot" aria-hidden="true"></span>
    <span id="pillText">Przerwa techniczna</span>
  </p>

  <h1 id="tytul">Trwa aktualizacja systemu USOS</h1>
  <div class="lead-blok">
    <p class="lead" id="opis">
      Prowadzimy zaplanowane prace serwisowe. Przepraszamy za utrudnienia.
    </p>
  </div>

  <!-- ODLICZANIE -->
  <section class="counter" id="counter" aria-labelledby="counterLabel">
    <p class="counter__label" id="counterLabel">System będzie dostępny za</p>

    <div class="tiles" id="tiles" role="timer" aria-hidden="true">
      <div class="tile" id="tileDni">
        <span class="tile__num" id="numDni">0</span>
        <span class="tile__lab" id="labDni">dni</span>
      </div>
      <div class="tile">
        <span class="tile__num" id="numGodz">00</span>
        <span class="tile__lab" id="labGodz">godzin</span>
      </div>
      <div class="tile">
        <span class="tile__num" id="numMin">00</span>
        <span class="tile__lab" id="labMin">minut</span>
      </div>
      <div class="tile tile--sek">
        <span class="tile__num" id="numSek">00</span>
        <span class="tile__lab" id="labSek">sekund</span>
      </div>
    </div>

    <p class="sr-only" id="srCzas" aria-live="polite"></p>

    <!-- PASEK POSTĘPU -->
    <div class="progress-block" id="progressBlock" hidden>
      <div class="progress-block__row">
        <span>Postęp prac</span>
        <span id="progressPct">0%</span>
      </div>
      <div class="progress" role="progressbar" id="progressBar"
           aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"
           aria-label="Postęp prac serwisowych">
        <div class="progress__fill" id="progressFill" style="width:0%"></div>
      </div>
    </div>

    <p class="eta" id="eta"></p>
  </section>


  <!-- STAN KOŃCOWY / PRZEDŁUŻENIE -->
  <section class="notice" id="notice" hidden aria-live="polite">
    <h2 class="notice__title" id="noticeTitle"></h2>
    <p class="notice__text" id="noticeText"></p>
    <button class="btn" type="button" id="btnRetry">Sprawdź ponownie</button>
  </section>

  <!-- ===================================================================
       STOPKA — wspólna dla aplikacji CNT (panel, legitymacje,
       logger-viewer, ad-manager). Treść edytuje się TUTAJ, nie w config.js.
       Ikony to Bootstrap Icons 1.11.2 osadzone jako SVG — zaślepka nie
       może zależeć od CDN-u, bo ma działać, gdy reszta nie działa.
       =================================================================== -->

</main>

