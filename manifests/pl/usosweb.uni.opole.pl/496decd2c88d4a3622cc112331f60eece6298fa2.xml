          <svg class="ico" aria-hidden="true"><use href="#i-envelope"/></svg>
          <a href="mailto:helpdesk@uni.opole.pl">helpdesk@uni.opole.pl</a>
        </p>
        <p class="app-footer__p">
          <svg class="ico" aria-hidden="true"><use href="#i-life-preserver"/></svg>
          <a href="https://pomoc.uni.opole.pl" target="_blank" rel="noopener">pomoc.uni.opole.pl</a>
        </p>
      </section>

      <section class="app-footer__col">
        <h2 class="app-footer__h"><svg class="ico" aria-hidden="true"><use href="#i-link"/></svg> Szybkie linki</h2>
        <div class="app-footer__btny">
          <a class="btn-outline" href="https://poczta.uni.opole.pl" target="_blank" rel="noopener">
            <svg class="ico" aria-hidden="true"><use href="#i-envelope-fill"/></svg> Poczta
          </a>
          <a class="btn-outline" href="https://moodle.uni.opole.pl" target="_blank" rel="noopener">
            <svg class="ico" aria-hidden="true"><use href="#i-book-fill"/></svg> Moodle
          </a>
          <a class="btn-outline" href="https://uni.opole.pl" target="_blank" rel="noopener">
            <svg class="ico" aria-hidden="true"><use href="#i-mortarboard-fill"/></svg> Uniwersytet
          </a>
        </div>
      </section>

    </div>

    <hr class="app-footer__hr">

    <div class="app-footer__dol">
      <small>2026 Centrum Nowoczesnych Technologii UO. Wszystkie prawa zastrzeżone.</small>
