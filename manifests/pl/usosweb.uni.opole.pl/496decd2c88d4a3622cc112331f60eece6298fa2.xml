<!-- dekoracyjny łuk nawiązujący do znaku UO -->
<svg class="deco" viewBox="0 0 600 600" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="decoGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%"  stop-color="#FF9800"/>
      <stop offset="100%" stop-color="#FF9800" stop-opacity="0"/>
    </linearGradient>
  </defs>
  <path d="M300 40 A260 260 0 0 1 560 300 L440 300 A140 140 0 0 0 300 160 Z" fill="url(#decoGrad)"/>
